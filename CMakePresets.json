{
  "$schema": "https://raw.githubusercontent.com/Kitware/CMake/v3.28.0/Help/manual/presets/schema.json",
  "version": 8,
  "cmakeMinimumRequired": { "major": 3, "minor": 28, "patch": 0 },

  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Shared defaults inherited by all visible presets — not selectable directly",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake"
      }
    },

    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Debug info, no optimization, asserts enabled — the default dev configuration",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIOSIM_BUILD_TESTS": "ON"
      }
    },

    {
      "name": "release",
      "displayName": "Release",
      "description": "O3 + LTO, asserts disabled — use for performance measurements and shipping",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BIOSIM_BUILD_TESTS": "OFF"
      }
    },

    {
      "name": "asan",
      "displayName": "AddressSanitizer",
      "description": "Debug info + AddressSanitizer + UBSan — GCC and Clang only",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BIOSIM_BUILD_TESTS": "ON",
        "BIOSIM_SANITIZE": "ON"
      }
    },

    {
      "name": "ci",
      "displayName": "CI",
      "description": "Release build with tests enabled — used by all CI jobs",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BIOSIM_BUILD_TESTS": "ON"
      }
    }
  ],

  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "Incremental build in debug mode"
    },
    {
      "name": "release",
      "configurePreset": "release",
      "description": "Parallel release build"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "description": "Build with sanitizers enabled"
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "description": "Build for CI (release + tests)"
    }
  ],

  "testPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "description": "Run tests built under the debug preset",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "description": "Run sanitizer-instrumented tests",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "ci",
      "configurePreset": "ci",
      "description": "Run tests in CI",
      "output": { "outputOnFailure": true }
    }
  ]
}
